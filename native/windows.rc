#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 ICON "../assets/EoriniZip.ico"
1 RT_MANIFEST "windows.manifest"
IDD_CREATE DIALOGEX 0, 0, 250, 165
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "새로 압축하기"
FONT 9, "Segoe UI"
BEGIN
  LISTBOX IDC_INPUTS, 10, 8, 230, 32, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "+ 파일", IDC_ADD_FILES, 10, 43, 38, 14
  PUSHBUTTON "+ 폴더", IDC_ADD_FOLDER, 51, 43, 38, 14
  PUSHBUTTON "비우기", IDC_CLEAR_INPUTS, 202, 43, 38, 14

  LTEXT "저장", -1, 10, 63, 20, 10
  EDITTEXT IDC_OUTPUT, 32, 61, 184, 14, ES_AUTOHSCROLL
  PUSHBUTTON "...", IDC_BROWSE_OUTPUT, 220, 61, 20, 14

  LTEXT "형식", -1, 10, 81, 20, 10
  COMBOBOX IDC_FORMAT, 32, 79, 78, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "방법", -1, 122, 81, 20, 10
  COMBOBOX IDC_LEVEL, 144, 79, 96, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

  LTEXT "암호", -1, 10, 99, 20, 10
  EDITTEXT IDC_PASSWORD, 32, 97, 78, 14, ES_PASSWORD | ES_AUTOHSCROLL
  LTEXT "분할", -1, 122, 99, 20, 10
  COMBOBOX IDC_SPLIT, 144, 97, 96, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  EDITTEXT IDC_CUSTOM_SPLIT, 144, 97, 96, 14, ES_AUTOHSCROLL

  CONTROL "파일명 암호화", IDC_HIDE_NAMES, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 117, 105, 12
  CONTROL "압축 후 검증", IDC_TEST_AFTER, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 122, 117, 118, 12

  LTEXT "", IDC_DIALOG_ERROR, 10, 132, 120, 12
  DEFPUSHBUTTON "압축", IDOK, 144, 144, 46, 15
  PUSHBUTTON "취소", IDCANCEL, 194, 144, 46, 15
END
IDD_COMMENT DIALOGEX 0, 0, 400, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ZIP 압축 설명 - 어린이zip"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "설명은 암호화되지 않습니다. UTF-8로 저장합니다.", -1, 10, 8, 380, 12
  EDITTEXT IDC_COMMENT_TEXT, 10, 25, 380, 165, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
  DEFPUSHBUTTON "저장", IDOK, 266, 202, 60, 18
  PUSHBUTTON "취소", IDCANCEL, 332, 202, 58, 18
END
IDD_FIND DIALOGEX 0, 0, 300, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "파일 찾기"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "파일 이름에 포함된 글자", -1, 10, 10, 180, 12
  EDITTEXT IDC_FIND_TEXT, 10, 26, 280, 20, ES_AUTOHSCROLL
  LTEXT "", IDC_FIND_RESULT, 10, 50, 280, 18, SS_PATHELLIPSIS
  DEFPUSHBUTTON "다음 찾기", IDOK, 156, 74, 64, 18
  PUSHBUTTON "닫기", IDCANCEL, 226, 74, 64, 18
END
IDD_SETTINGS DIALOGEX 0, 0, 480, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "환경 설정 - 어린이zip"
FONT 9, "Segoe UI"
BEGIN
  LISTBOX IDC_CATEGORIES, 8, 8, 92, 244, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "초기화", IDC_PREF_RESET, 8, 259, 92, 16
  DEFPUSHBUTTON "확인", IDOK, 345, 276, 60, 18
  PUSHBUTTON "취소", IDCANCEL, 411, 276, 60, 18
  LTEXT "", IDC_SETTINGS_TITLE, 112, 14, 355, 16
  CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 112, 35, 355, 1
  LTEXT "", IDC_SETTINGS_NOTE, 112, 190, 355, 76
  CONTROL "ESC 키로 프로그램 종료", IDC_PREF_ESCAPE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 16
  CONTROL "파일 목록에 눈금선 보이기", IDC_PREF_GRID, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 71, 320, 16
  CONTROL "파일 목록 창에 전체 행 선택 기능 사용", IDC_PREF_FULLROW, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 93, 320, 16
  CONTROL "프로그램 시작 시 시작 화면 보여주기", IDC_PREF_HOME, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 115, 320, 16
  CONTROL "압축 후 압축 파일 테스트", IDC_PREF_TEST, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 16
  CONTROL "ZIP 파일 이름을 UTF-8로 저장", IDC_PREF_UNICODE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 108, 320, 16
  CONTROL "만든 날짜와 접근 날짜 저장 (ZIP / 7Z)", IDC_PREF_TIMES, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 130, 320, 16
  CONTROL "압축 완료 후 작업 창 자동으로 닫기", IDC_PREF_CLOSE_CREATE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 174, 320, 14
  CONTROL "압축 해제 완료 후 작업 창 자동으로 닫기", IDC_PREF_CLOSE_EXTRACT, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 108, 320, 16
  CONTROL "Thumbs.db 제외", IDC_PREF_THUMBS, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 152, 320, 16
  COMBOBOX IDC_PREF_CODEPAGE, 124, 49, 300, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  CONTROL "엔진 멀티코어 처리 사용", IDC_PREF_PARALLEL, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 82, 320, 16
  CONTROL "다운로드 출처 정보를 해제한 파일에도 보존", IDC_PREF_ZONE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 32
  PUSHBUTTON "환경 설정 내보내기...", IDC_PREF_EXPORT, 124, 49, 180, 22
  PUSHBUTTON "환경 설정 가져오기...", IDC_PREF_IMPORT, 124, 82, 180, 22
  LISTBOX IDC_ASSOC_LIST, 124, 49, 190, 100, LBS_MULTIPLESEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "연결 프로그램 등록", IDC_ASSOC_APPLY, 322, 49, 135, 20
  PUSHBUTTON "Windows 기본 앱 설정", IDC_DEFAULT_APPS, 322, 77, 135, 20
  PUSHBUTTON "전체 선택", IDC_ASSOC_ALL, 322, 105, 65, 20
  PUSHBUTTON "전체 해제", IDC_ASSOC_NONE, 392, 105, 65, 20
  PUSHBUTTON "탐색기 메뉴 등록", IDC_SHELL_INSTALL, 124, 49, 150, 22
  PUSHBUTTON "탐색기 메뉴 제거", IDC_SHELL_REMOVE, 284, 49, 150, 22
  CONTROL "폴더 트리 표시", IDC_PREF_TREE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 16
  CONTROL "상태 표시줄 표시", IDC_PREF_STATUS, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 71, 320, 16
  PUSHBUTTON "테마 색상 선택...", IDC_PREF_COLOR, 124, 101, 150, 22
  COMBOBOX IDC_PREF_FONT, 124, 132, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  COMBOBOX IDC_PREF_FONT_SIZE, 284, 132, 150, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  PUSHBUTTON "칼럼 표시 선택...", IDC_PREF_COLUMNS, 284, 101, 150, 22
  PUSHBUTTON "임시 폴더 선택...", IDC_PREF_TEMP, 124, 115, 150, 22
  PUSHBUTTON "OS 임시 폴더 사용", IDC_PREF_TEMP_RESET, 284, 115, 150, 22
  CONTROL "시작할 때 업데이트 확인 (GitHub 접속)", IDC_PREF_UPDATE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 148, 320, 16
  COMBOBOX IDC_PREF_LANGUAGE, 124, 49, 250, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  COMBOBOX IDC_PREF_LEVEL, 124, 76, 180, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END
IDD_PROGRESS DIALOGEX 0, 0, 210, 48
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "작업 진행"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "준비 중...", IDC_PROGRESS_STATUS, 10, 7, 190, 10, SS_PATHELLIPSIS
  CONTROL "", IDC_PROGRESS_BAR, "msctls_progress32", PBS_SMOOTH, 10, 19, 190, 6
