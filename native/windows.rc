#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
1 ICON "../assets/EoriniZip.ico"
1 RT_MANIFEST "windows.manifest"
IDD_CREATE DIALOGEX 0, 0, 414, 345
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "새로 압축하기 - 어린이zip"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "압축할 파일 / 폴더", -1, 12, 12, 190, 12
  LISTBOX IDC_INPUTS, 12, 28, 390, 75, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "파일 추가...", IDC_ADD_FILES, 12, 109, 70, 18
  PUSHBUTTON "폴더 추가...", IDC_ADD_FOLDER, 87, 109, 70, 18
  PUSHBUTTON "목록 비우기", IDC_CLEAR_INPUTS, 332, 109, 70, 18
  LTEXT "파일 이름", -1, 12, 141, 75, 12
  EDITTEXT IDC_OUTPUT, 93, 137, 264, 20, ES_AUTOHSCROLL
  PUSHBUTTON "...", IDC_BROWSE_OUTPUT, 362, 137, 40, 20
  LTEXT "압축 형식", -1, 12, 168, 75, 12
  COMBOBOX IDC_FORMAT, 93, 164, 160, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "분할 압축", -1, 12, 195, 75, 12
  COMBOBOX IDC_SPLIT, 93, 191, 160, 300, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  EDITTEXT IDC_CUSTOM_SPLIT, 262, 191, 140, 20, ES_AUTOHSCROLL
  LTEXT "압축 방법", -1, 12, 222, 75, 12
  COMBOBOX IDC_LEVEL, 93, 218, 160, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  LTEXT "비밀번호", -1, 12, 249, 75, 12
  EDITTEXT IDC_PASSWORD, 93, 245, 160, 20, ES_PASSWORD | ES_AUTOHSCROLL
  CONTROL "파일명 암호화 (7Z)", IDC_HIDE_NAMES, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 262, 246, 140, 18
  CONTROL "압축 후 테스트", IDC_TEST_AFTER, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 276, 130, 16
  LTEXT "지정한 위치에 저장됩니다. 같은 이름은 번호를 붙입니다.", -1, 153, 279, 249, 12
  LTEXT "", IDC_DIALOG_ERROR, 12, 300, 260, 30
  DEFPUSHBUTTON "압축 시작", IDOK, 279, 313, 60, 20
  PUSHBUTTON "취소", IDCANCEL, 344, 313, 58, 20
END
IDD_FIND DIALOGEX 0, 0, 300, 100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "파일 찾기"
FONT 9, "Segoe UI"
BEGIN
  LTEXT "파일 이름에 포함된 글자", -1, 10, 10, 180, 12
  EDITTEXT IDC_FIND_TEXT, 10, 26, 280, 20, ES_AUTOHSCROLL
  LTEXT "", IDC_FIND_RESULT, 10, 50, 280, 18, SS_PATHELLIPSIS
  DEFPUSHBUTTON "다음 찾기", IDOK, 156, 74, 64, 18
  PUSHBUTTON "닫기", IDCANCEL, 226, 74, 64, 18
END
IDD_SETTINGS DIALOGEX 0, 0, 480, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "환경 설정 - 어린이zip"
FONT 9, "Segoe UI"
BEGIN
  LISTBOX IDC_CATEGORIES, 8, 8, 92, 244, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "초기화", IDC_PREF_RESET, 8, 259, 92, 16
  DEFPUSHBUTTON "확인", IDOK, 345, 276, 60, 18
  PUSHBUTTON "취소", IDCANCEL, 411, 276, 60, 18
  LTEXT "", IDC_SETTINGS_TITLE, 112, 14, 355, 16
  CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 112, 35, 355, 1
  LTEXT "", IDC_SETTINGS_NOTE, 112, 190, 355, 76
  CONTROL "ESC 키로 프로그램 종료", IDC_PREF_ESCAPE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 16
  CONTROL "파일 목록에 눈금선 보이기", IDC_PREF_GRID, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 71, 320, 16
  CONTROL "파일 목록 창에 전체 행 선택 기능 사용", IDC_PREF_FULLROW, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 93, 320, 16
  CONTROL "프로그램 시작 시 시작 화면 보여주기", IDC_PREF_HOME, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 115, 320, 16
  CONTROL "압축 후 압축 파일 테스트", IDC_PREF_TEST, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 16
  CONTROL "ZIP 파일 이름을 UTF-8로 저장", IDC_PREF_UNICODE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 108, 320, 16
  CONTROL "만든 날짜와 접근 날짜 저장 (ZIP / 7Z)", IDC_PREF_TIMES, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 130, 320, 16
  CONTROL "Thumbs.db 제외", IDC_PREF_THUMBS, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 152, 320, 16
  COMBOBOX IDC_PREF_CODEPAGE, 124, 49, 300, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
  CONTROL "엔진 멀티코어 처리 사용", IDC_PREF_PARALLEL, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 82, 320, 16
  CONTROL "다운로드 출처 정보를 해제한 파일에도 보존", IDC_PREF_ZONE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 32
  PUSHBUTTON "환경 설정 내보내기...", IDC_PREF_EXPORT, 124, 49, 180, 22
  LISTBOX IDC_ASSOC_LIST, 124, 49, 190, 100, LBS_MULTIPLESEL | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
  PUSHBUTTON "연결 프로그램 등록", IDC_ASSOC_APPLY, 322, 49, 135, 20
  PUSHBUTTON "Windows 기본 앱 설정", IDC_DEFAULT_APPS, 322, 77, 135, 20
  PUSHBUTTON "탐색기 메뉴 등록", IDC_SHELL_INSTALL, 124, 49, 150, 22
  PUSHBUTTON "탐색기 메뉴 제거", IDC_SHELL_REMOVE, 284, 49, 150, 22
  CONTROL "폴더 트리 표시", IDC_PREF_TREE, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 49, 320, 16
  CONTROL "상태 표시줄 표시", IDC_PREF_STATUS, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 71, 320, 16
  PUSHBUTTON "테마 색상 선택...", IDC_PREF_COLOR, 124, 101, 150, 22
  COMBOBOX IDC_PREF_LEVEL, 124, 76, 180, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END
IDD_PROGRESS DIALOGEX 0, 0, 340, 45
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "작업 준비 중 - 어린이zip"
FONT 9, "Segoe UI"
BEGIN
  CONTROL "", IDC_PROGRESS_BAR, "msctls_progress32", PBS_SMOOTH, 7, 7, 326, 10
  LTEXT "준비 중...", IDC_PROGRESS_STATUS, 7, 25, 273, 12, SS_PATHELLIPSIS
  DEFPUSHBUTTON "취소", IDCANCEL, 287, 22, 46, 16
END