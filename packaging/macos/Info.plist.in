<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>EoriniZip</string>
  <key>CFBundleIdentifier</key><string>io.eorinizip.desktop</string>
  <key>CFBundleName</key><string>EoriniZip</string>
